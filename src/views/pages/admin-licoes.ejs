<nav>
  <div class="logo">&lt;/&gt; CodeLab <span class="admin-badge">Admin</span></div>
  <ul>
    <li><a href="/admin">Dashboard</a></li>
    <li><a href="/admin/desafios">Desafios</a></li>
    <li><a href="/admin/categorias">Categorias</a></li>
    <li><a href="/admin/usuarios">Usuários</a></li>
    <li><a href="/admin/comentarios">Comentários</a></li>
    <li><a href="/admin/licoes" class="nav-ativo">Lições</a></li>
    <li><a href="/dashboard">← Site</a></li>
  </ul>
  <a href="/perfil" class="usuario">
    <div class="avatar-inicial"><%= user.name.charAt(0).toUpperCase() %></div>
    <%= user.name %>
  </a>
</nav>

<div class="admin-page">

  <% if (messages.success && messages.success.length > 0) { %>
    <div class="msg-sucesso"><%= messages.success[0] %></div>
  <% } %>
  <% if (messages.error && messages.error.length > 0) { %>
    <div class="msg-erro"><%= messages.error[0] %></div>
  <% } %>

  <div class="admin-titulo">
    <h1>Lições — SkillUp</h1>
    <p>Cadastre e gerencie as lições da plataforma</p>
  </div>

  <div class="admin-cols">

    <div class="admin-form-card">
      <h2>Nova Lição</h2>
      <form method="POST" action="/admin/licoes">

        <div class="form-group">
          <label>Título</label>
          <input type="text" name="title" placeholder="Ex: Introdução ao TDD" required>
        </div>

        <div class="form-group">
          <label>Descrição</label>
          <textarea name="description" rows="3" placeholder="Breve descrição da lição..." style="width:100%;padding:8px 10px;border:1px solid #ccc;font-size:13px;resize:vertical;font-family:Arial,sans-serif;box-sizing:border-box;"></textarea>
        </div>

        <div class="form-group">
          <label>Conteúdo</label>
          <textarea name="content" rows="5" placeholder="Conteúdo completo da lição..." style="width:100%;padding:8px 10px;border:1px solid #ccc;font-size:13px;resize:vertical;font-family:Arial,sans-serif;box-sizing:border-box;"></textarea>
        </div>

        <div class="form-group">
          <label>Categoria</label>
          <input type="text" name="category" placeholder="Ex: TDD, JavaScript, Testes">
        </div>

        <div class="form-group">
          <label>Nível</label>
          <select name="level" style="width:100%;padding:8px 10px;border:1px solid #ccc;font-size:14px;">
            <option value="iniciante">Iniciante</option>
            <option value="intermediario">Intermediário</option>
            <option value="avancado">Avançado</option>
          </select>
        </div>

        <button type="submit" class="btn-admin-salvar">Cadastrar Lição</button>
      </form>
    </div>

    <div class="admin-lista-card">
      <h2>Lições Cadastradas (<%= licoes.length %>)</h2>
      <% if (licoes.length === 0) { %>
        <p style="color:#888; text-align:center; padding:2rem;">Nenhuma lição cadastrada ainda.</p>
      <% } else { %>
        <% licoes.forEach(function(licao) { %>
          <div class="admin-item">
            <div class="admin-item-info">
              <strong><%= licao.title %></strong>
              <span class="admin-item-meta"><%= licao.category %> · <%= licao.level %></span>
            </div>
            <form method="POST" action="/admin/licoes/<%= licao.id %>/excluir" onsubmit="return confirm('Remover esta lição?')">
              <button type="submit" class="btn-excluir">Excluir</button>
            </form>
          </div>
        <% }); %>
      <% } %>
    </div>

  </div>
</div>
